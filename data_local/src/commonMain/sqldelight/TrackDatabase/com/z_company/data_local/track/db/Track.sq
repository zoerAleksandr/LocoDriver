-- Локальные GPS-треки «АВТО» (SCREEN_SPECS §6.9). Отдельный файл БД Track.db: основная Route.db
-- не затрагивается, миграций существующих баз нет (новая БД создаётся при первом открытии).

CREATE TABLE IF NOT EXISTS Track (
    trackId TEXT NOT NULL PRIMARY KEY,
    trainId TEXT NOT NULL,
    startedAt INTEGER NOT NULL,
    endedAt INTEGER NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    -- Отправка на сервер (этап 3б, миграция 1.sqm): 0 — ждёт, 1 — отправлен, 2 — отклонён (квота и т.п.).
    uploadState INTEGER NOT NULL DEFAULT 0,
    -- Сколько точек было в отправленной версии: трек вырос — отправляем заново.
    uploadedPoints INTEGER NOT NULL DEFAULT 0,
    -- Звезда изменена локально и ещё не доставлена на сервер.
    favoriteDirty INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS index_Track_trainId ON Track(trainId);
CREATE INDEX IF NOT EXISTS index_Track_endedAt ON Track(endedAt);

-- Удаления, которые нужно доставить на сервер (офлайн/нет входа); DELETE идемпотентен, повтор безопасен.
CREATE TABLE IF NOT EXISTS TrackPendingDelete (
    trackId TEXT NOT NULL PRIMARY KEY
);

-- Первичный ключ (trackId, timeMs) — он же индекс по треку и времени.
CREATE TABLE IF NOT EXISTS TrackPoint (
    trackId TEXT NOT NULL,
    timeMs INTEGER NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    speedKmh REAL,
    accuracyM REAL,
    altitudeM REAL,
    -- Барометрическая высота (этап 3в, миграция 2.sqm); null - датчика давления нет.
    baroAltitudeM REAL,
    PRIMARY KEY (trackId, timeMs)
) WITHOUT ROWID;

-- Журнал проследования ограничений (миграция 3.sqm): время и скорость захода/выхода составом по предупреждениям поезда.
-- Без координат: только время, скорость и км/пикет. Ключ (trainId, warningId); remove = надгробие (isDeleted = 1) до отправки на сервер.
CREATE TABLE IF NOT EXISTS RestrictionPass (
    trainId TEXT NOT NULL,
    warningId TEXT NOT NULL,
    routeId TEXT NOT NULL,
    sectionId TEXT NOT NULL,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    place TEXT NOT NULL DEFAULT '',
    note TEXT NOT NULL DEFAULT '',
    limitKmh INTEGER,
    startAbsKm REAL,
    endAbsKm REAL,
    startRelKm REAL NOT NULL DEFAULT 0,
    endRelKm REAL NOT NULL DEFAULT 0,
    enterAt INTEGER,
    enterSpeedKmh REAL,
    enterApprox INTEGER NOT NULL DEFAULT 0,
    exitAt INTEGER,
    exitSpeedKmh REAL,
    exitByHead INTEGER NOT NULL DEFAULT 0,
    trainLengthM INTEGER,
    dir INTEGER NOT NULL DEFAULT 0,
    maxSpeedKmh REAL,
    exceeded INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    -- 1 - изменено локально и ещё не доставлено на сервер.
    dirty INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (trainId, warningId)
);

CREATE INDEX IF NOT EXISTS index_RestrictionPass_dirty ON RestrictionPass(dirty);

insertTrack:
INSERT OR IGNORE INTO Track(trackId, trainId, startedAt, endedAt, isFavorite) VALUES (?, ?, ?, ?, 0);

touchTrack:
UPDATE Track SET endedAt = MAX(endedAt, :endedAt) WHERE trackId = :trackId;

insertPoint:
INSERT OR IGNORE INTO TrackPoint(trackId, timeMs, latitude, longitude, speedKmh, accuracyM, altitudeM, baroAltitudeM)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectPoints:
SELECT * FROM TrackPoint WHERE trackId = :trackId ORDER BY timeMs ASC;

countPoints:
SELECT COUNT(*) FROM TrackPoint WHERE trackId = :trackId;

selectTracks:
SELECT * FROM Track ORDER BY startedAt DESC;

selectTracksByTrain:
SELECT * FROM Track WHERE trainId = :trainId ORDER BY startedAt DESC;

selectTrack:
SELECT * FROM Track WHERE trackId = :trackId;

setFavorite:
UPDATE Track SET isFavorite = :isFavorite, favoriteDirty = 1 WHERE trackId = :trackId;

clearFavoriteDirty:
UPDATE Track SET favoriteDirty = 0 WHERE trackId = :trackId;

setUploadState:
UPDATE Track SET uploadState = :uploadState, uploadedPoints = :uploadedPoints WHERE trackId = :trackId;

resetAllUploadState:
UPDATE Track SET uploadState = 0, uploadedPoints = 0, favoriteDirty = 0;

-- Склейка треков: точки поглощённого переносятся в оставляемый (дубли по времени игнорируются).
moveTrackPoints:
INSERT OR IGNORE INTO TrackPoint(trackId, timeMs, latitude, longitude, speedKmh, accuracyM, altitudeM, baroAltitudeM)
SELECT :keepTrackId, timeMs, latitude, longitude, speedKmh, accuracyM, altitudeM, baroAltitudeM
FROM TrackPoint WHERE trackId = :absorbedTrackId;

updateMergedTrack:
UPDATE Track SET startedAt = :startedAt, endedAt = :endedAt, isFavorite = :isFavorite, favoriteDirty = :favoriteDirty,
    uploadState = :uploadState, uploadedPoints = 0
WHERE trackId = :trackId;

-- Починка ложных меток времени: точки вне границ удаляются, границы пересчитываются, трек уходит на сервер заново.
deletePointsOutside:
DELETE FROM TrackPoint WHERE trackId = :trackId AND (timeMs < :startedAt OR timeMs > :endedAt);

updateTrackBounds:
UPDATE Track SET startedAt = :startedAt, endedAt = :endedAt, uploadedPoints = 0 WHERE trackId = :trackId;

deletePointsOne:
DELETE FROM TrackPoint WHERE trackId = :trackId;

deleteTrackOne:
DELETE FROM Track WHERE trackId = :trackId;

insertPendingDelete:
INSERT OR IGNORE INTO TrackPendingDelete(trackId) VALUES (?);

selectPendingDeletes:
SELECT trackId FROM TrackPendingDelete;

deletePendingDelete:
DELETE FROM TrackPendingDelete WHERE trackId = :trackId;

deleteAllPendingDeletes:
DELETE FROM TrackPendingDelete;

selectTrackIdsByTrain:
SELECT trackId FROM Track WHERE trainId = :trainId;

deletePointsByTrain:
DELETE FROM TrackPoint WHERE trackId IN (SELECT trackId FROM Track WHERE trainId = :trainId);

deleteTracksByTrain:
DELETE FROM Track WHERE trainId = :trainId;

deleteAllPoints:
DELETE FROM TrackPoint;

deleteAllTracks:
DELETE FROM Track;

-- Просроченные: не избранные и закончившиеся раньше границы.
countExpiredTracks:
SELECT COUNT(*) FROM Track WHERE isFavorite = 0 AND endedAt < :cutoff;

deleteExpiredPoints:
DELETE FROM TrackPoint WHERE trackId IN (SELECT trackId FROM Track WHERE isFavorite = 0 AND endedAt < :cutoff);

deleteExpiredTracks:
DELETE FROM Track WHERE isFavorite = 0 AND endedAt < :cutoff;

-- Журнал проследования ограничений.
selectPassesByTrain:
SELECT * FROM RestrictionPass WHERE trainId = :trainId AND isDeleted = 0 ORDER BY updatedAt ASC;

selectOpenPassesByTrain:
SELECT * FROM RestrictionPass WHERE trainId = :trainId AND isDeleted = 0
  AND (enterAt IS NULL OR (kind = 'speed' AND exitAt IS NULL))
ORDER BY updatedAt ASC;

selectPass:
SELECT * FROM RestrictionPass WHERE trainId = :trainId AND warningId = :warningId;

upsertPass:
INSERT OR REPLACE INTO RestrictionPass(
    trainId, warningId, routeId, sectionId, kind, title, place, note, limitKmh, startAbsKm, endAbsKm, startRelKm, endRelKm,
    enterAt, enterSpeedKmh, enterApprox, exitAt, exitSpeedKmh, exitByHead, trainLengthM, dir, maxSpeedKmh, exceeded,
    updatedAt, isDeleted, dirty
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

tombstonePass:
UPDATE RestrictionPass SET isDeleted = 1, dirty = 1, updatedAt = :updatedAt WHERE trainId = :trainId AND warningId = :warningId;

tombstonePassesByTrain:
UPDATE RestrictionPass SET isDeleted = 1, dirty = 1, updatedAt = MAX(updatedAt + 1, :updatedAt) WHERE trainId = :trainId AND isDeleted = 0;

selectPendingPasses:
SELECT * FROM RestrictionPass WHERE dirty = 1 LIMIT :limit;

markPassUploaded:
UPDATE RestrictionPass SET dirty = 0 WHERE trainId = :trainId AND warningId = :warningId AND updatedAt = :updatedAt;

-- Надгробия, уже доставленные на сервер, локально больше не нужны.
purgeUploadedTombstones:
DELETE FROM RestrictionPass WHERE isDeleted = 1 AND dirty = 0;

deleteAllPasses:
DELETE FROM RestrictionPass;
