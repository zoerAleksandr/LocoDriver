CREATE TABLE IF NOT EXISTS BasicData (
    id TEXT NOT NULL PRIMARY KEY,
    isSynchronizedRoute INTEGER NOT NULL DEFAULT 0,
    remoteRouteId TEXT DEFAULT NULL,
    isOnePersonOperation INTEGER NOT NULL DEFAULT 0,
    isSynchronized INTEGER NOT NULL,
    remoteObjectId TEXT,
    isDeleted INTEGER NOT NULL,
    updatedAt TEXT NOT NULL,
    number TEXT,
    timeStartWork INTEGER,
    timeEndWork INTEGER,
    restPointOfTurnover INTEGER NOT NULL,
    notes TEXT,
    isFavorite INTEGER NOT NULL DEFAULT 0
);

insertOrReplace:
INSERT OR REPLACE INTO BasicData (id, isSynchronizedRoute, remoteRouteId, isOnePersonOperation, isSynchronized, remoteObjectId, isDeleted, updatedAt, number, timeStartWork, timeEndWork, restPointOfTurnover, notes, isFavorite)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getById:
SELECT * FROM BasicData WHERE id = :id;

getAll:
SELECT * FROM BasicData WHERE isDeleted = 0;

getAllWithDeleted:
SELECT * FROM BasicData;

getByPeriod:
SELECT * FROM BasicData
WHERE isDeleted = 0
  AND (
    (timeStartWork >= :startPeriod AND timeStartWork <= :endPeriod)
    OR (timeEndWork >= :startPeriod AND timeEndWork <= :endPeriod)
    OR (timeStartWork <= :startPeriod AND timeEndWork >= :endPeriod)
    OR (timeStartWork <= :endPeriod AND timeEndWork IS NULL)
  )
ORDER BY timeStartWork DESC;

delete:
DELETE FROM BasicData WHERE id = :id;

deleteAll:
DELETE FROM BasicData;

setRemoteObjectId:
UPDATE BasicData SET remoteObjectId = :remoteObjectId WHERE id = :id;

setSynchronized:
UPDATE BasicData SET isSynchronized = 1 WHERE id = :id;

setRemoteRouteId:
UPDATE BasicData SET remoteRouteId = :remoteRouteId WHERE id = :id;

setFavorite:
UPDATE BasicData SET isFavorite = :favorite, isSynchronizedRoute = 0 WHERE id = :id;
