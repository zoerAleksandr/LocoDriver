CREATE TABLE IF NOT EXISTS BasicData (
    id TEXT NOT NULL PRIMARY KEY,
    remoteRouteId TEXT DEFAULT NULL,
    isOnePersonOperation INTEGER NOT NULL DEFAULT 0,
    isSynchronized INTEGER NOT NULL,
    remoteObjectId TEXT,
    isDeleted INTEGER NOT NULL,
    deletedAt INTEGER,
    deletionReason TEXT,
    remoteDeletionPending INTEGER NOT NULL DEFAULT 0,
    remoteDeletedAt INTEGER,
    updatedAt TEXT NOT NULL,
    number TEXT,
    timeStartWork INTEGER,
    timeEndWork INTEGER,
    restPointOfTurnover INTEGER NOT NULL,
    notes TEXT,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    timeStartBreak INTEGER,
    timeEndBreak INTEGER,
    timeStartWorkBeforeArrival INTEGER
);

insertOrReplace:
INSERT OR REPLACE INTO BasicData (id, remoteRouteId, isOnePersonOperation, isSynchronized, remoteObjectId, isDeleted, deletedAt, deletionReason, remoteDeletionPending, remoteDeletedAt, updatedAt, number, timeStartWork, timeEndWork, restPointOfTurnover, notes, isFavorite, timeStartBreak, timeEndBreak, timeStartWorkBeforeArrival)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getById:
SELECT * FROM BasicData WHERE id = :id;

getAll:
SELECT * FROM BasicData WHERE isDeleted = 0;

getAllWithDeleted:
SELECT * FROM BasicData;

getTrash:
SELECT * FROM BasicData WHERE isDeleted = 1 ORDER BY deletedAt DESC;

restoreFromTrash:
UPDATE BasicData
SET isDeleted = 0,
    deletedAt = NULL,
    deletionReason = NULL,
    remoteDeletionPending = 0,
    remoteDeletedAt = NULL,
    isSynchronized = 0,
    updatedAt = :updatedAt
WHERE id = :id AND isDeleted = 1;

acknowledgeRemoteDeletion:
UPDATE BasicData
SET remoteDeletionPending = 0,
    remoteDeletedAt = :remoteDeletedAt,
    isSynchronized = 1
WHERE id = :id AND isDeleted = 1;

getByPeriod:
SELECT * FROM BasicData
WHERE isDeleted = 0
  AND (
    (timeStartWork >= :startPeriod AND timeStartWork <= :endPeriod)
    OR (timeEndWork >= :startPeriod AND timeEndWork <= :endPeriod)
    OR (timeStartWork <= :startPeriod AND timeEndWork >= :endPeriod)
    OR (timeStartWork >= :startPeriod AND timeStartWork <= :endPeriod AND timeEndWork IS NULL)
  )
ORDER BY timeStartWork DESC;

delete:
DELETE FROM BasicData WHERE id = :id;

setRemoteObjectId:
UPDATE BasicData SET remoteObjectId = :remoteObjectId WHERE id = :id;

setSynchronized:
UPDATE BasicData SET isSynchronized = 1 WHERE id = :id;

setRemoteRouteId:
UPDATE BasicData SET remoteRouteId = :remoteRouteId WHERE id = :id;

setFavorite:
UPDATE BasicData SET isFavorite = :favorite WHERE id = :id;

markUnsynchronized:
UPDATE BasicData SET isSynchronized = 0, updatedAt = :updatedAt WHERE id = :id;
