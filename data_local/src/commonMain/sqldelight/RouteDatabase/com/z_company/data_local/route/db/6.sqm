-- Удаление неиспользуемого столбца isSynchronizedRoute из BasicData.
-- Поле никогда не читалось для принятия решений о синхронизации;
-- реальный флаг синхронизации — isSynchronized.
-- SQLite < 3.35 не поддерживает DROP COLUMN, поэтому пересоздаём таблицу.

CREATE TABLE BasicData_new (
    id TEXT NOT NULL PRIMARY KEY,
    remoteRouteId TEXT DEFAULT NULL,
    isOnePersonOperation INTEGER NOT NULL DEFAULT 0,
    isSynchronized INTEGER NOT NULL,
    remoteObjectId TEXT,
    isDeleted INTEGER NOT NULL,
    updatedAt TEXT NOT NULL,
    number TEXT,
    timeStartWork INTEGER,
    timeEndWork INTEGER,
    restPointOfTurnover INTEGER NOT NULL,
    notes TEXT,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    timeStartBreak INTEGER,
    timeEndBreak INTEGER
);

INSERT INTO BasicData_new SELECT
    id, remoteRouteId, isOnePersonOperation, isSynchronized, remoteObjectId,
    isDeleted, updatedAt, number, timeStartWork, timeEndWork, restPointOfTurnover,
    notes, isFavorite, timeStartBreak, timeEndBreak
FROM BasicData;

DROP TABLE BasicData;

ALTER TABLE BasicData_new RENAME TO BasicData;
