CREATE TABLE IF NOT EXISTS SalarySetting (
    salarySettingKey TEXT NOT NULL PRIMARY KEY,
    nightTimePercent REAL NOT NULL DEFAULT 40.0,
    zonalSurcharge REAL NOT NULL,
    averagePaymentHour REAL NOT NULL DEFAULT 0.0,
    districtCoefficient REAL NOT NULL DEFAULT 0.0,
    nordicCoefficient REAL NOT NULL DEFAULT 0.0,
    onePersonOperationPercent REAL NOT NULL DEFAULT 0.0,
    onePersonOperationPassengerTrainPercent REAL NOT NULL DEFAULT 50.0,
    harmfulnessPercent REAL NOT NULL DEFAULT 0.0,
    surchargeQualificationClass REAL NOT NULL,
    surchargeExtendedServicePhaseList TEXT NOT NULL,
    surchargeHeavyTrainsList TEXT NOT NULL DEFAULT '[]',
    surchargeLongTrainsList TEXT NOT NULL DEFAULT '[]',
    surchargeHeavyLongDistanceTrains REAL NOT NULL DEFAULT 5.0,
    surchargeLongTrain REAL NOT NULL DEFAULT 0.0,
    lengthLongDistanceTrain INTEGER NOT NULL DEFAULT 0,
    otherSurcharge REAL NOT NULL,
    ndfl REAL NOT NULL,
    unionistsRetention REAL NOT NULL,
    otherRetention REAL NOT NULL
);

insertOrReplace:
INSERT OR REPLACE INTO SalarySetting (salarySettingKey, nightTimePercent, zonalSurcharge, averagePaymentHour, districtCoefficient, nordicCoefficient, onePersonOperationPercent, onePersonOperationPassengerTrainPercent, harmfulnessPercent, surchargeQualificationClass, surchargeExtendedServicePhaseList, surchargeHeavyTrainsList, surchargeLongTrainsList, surchargeHeavyLongDistanceTrains, surchargeLongTrain, lengthLongDistanceTrain, otherSurcharge, ndfl, unionistsRetention, otherRetention)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getByKey:
SELECT * FROM SalarySetting WHERE salarySettingKey = :key;

getAll:
SELECT * FROM SalarySetting;
