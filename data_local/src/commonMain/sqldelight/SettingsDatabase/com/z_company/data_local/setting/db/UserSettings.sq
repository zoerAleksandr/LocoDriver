CREATE TABLE IF NOT EXISTS UserSettings (
    settingsKey TEXT NOT NULL PRIMARY KEY,
    minTimeRest INTEGER NOT NULL,
    minTimeHomeRest INTEGER NOT NULL,
    lastEnteredDieselCoefficient REAL NOT NULL,
    nightTime TEXT NOT NULL,
    updateAt INTEGER NOT NULL,
    defaultLocoType TEXT NOT NULL,
    defaultWorkTime INTEGER NOT NULL,
    usingDefaultWorkTime INTEGER NOT NULL,
    isConsiderFutureRoute INTEGER NOT NULL DEFAULT 1,
    monthOfYear TEXT NOT NULL,
    stationList TEXT NOT NULL DEFAULT '[]',
    timeZone INTEGER NOT NULL DEFAULT 0,
    locomotiveSeriesList TEXT NOT NULL DEFAULT '[]',
    servicePhases TEXT NOT NULL DEFAULT '[]',
    standardTimesStartWork TEXT NOT NULL DEFAULT '[28800000, 72000000]',
    subscriptionPeriod INTEGER NOT NULL DEFAULT 0,
    isDecimalTime INTEGER NOT NULL DEFAULT 0,
    isShowBreak INTEGER NOT NULL DEFAULT 1,
    isShowLocoHeating INTEGER NOT NULL DEFAULT 1,
    isShowLocoAuxiliary INTEGER NOT NULL DEFAULT 1,
    isShowLocoStatistics INTEGER NOT NULL DEFAULT 1,
    isShowLocoNorma INTEGER NOT NULL DEFAULT 1,
    isShowOtherCurrent INTEGER NOT NULL DEFAULT 0,
    country TEXT NOT NULL DEFAULT 'RU'
);

insertOrReplace:
INSERT OR REPLACE INTO UserSettings (settingsKey, minTimeRest, minTimeHomeRest, lastEnteredDieselCoefficient, nightTime, updateAt, defaultLocoType, defaultWorkTime, usingDefaultWorkTime, isConsiderFutureRoute, monthOfYear, stationList, timeZone, locomotiveSeriesList, servicePhases, standardTimesStartWork, subscriptionPeriod, isDecimalTime, isShowBreak, isShowLocoHeating, isShowLocoAuxiliary, isShowLocoStatistics, isShowLocoNorma, isShowOtherCurrent, country)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getByKey:
SELECT * FROM UserSettings WHERE settingsKey = :settingsKey;

getAll:
SELECT * FROM UserSettings;
