-- Колонки isShowLocoHeating/Auxiliary/Statistics уже добавлены миграцией 2
-- с NOT NULL DEFAULT 1. Повторный ALTER TABLE вызывал crash для пользователей,
-- успешно прошедших миграцию 2 ("table UserSettings already has a column named ...").
-- Оставляем только UPDATE для исправления NULL-значений у тех,
-- кто получил эти колонки через старую версию миграции 2 с DEFAULT NULL.
UPDATE UserSettings SET isShowLocoHeating = 1 WHERE isShowLocoHeating IS NULL;
UPDATE UserSettings SET isShowLocoAuxiliary = 1 WHERE isShowLocoAuxiliary IS NULL;
UPDATE UserSettings SET isShowLocoStatistics = 1 WHERE isShowLocoStatistics IS NULL;
