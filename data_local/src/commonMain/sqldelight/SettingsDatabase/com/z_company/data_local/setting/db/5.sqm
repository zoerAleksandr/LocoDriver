-- subscriptionPeriod и isDecimalTime присутствуют в схеме UserSettings.sq,
-- но отсутствовали в миграциях, что вызывало SQLiteException
-- "no such column: UserSettings.subscriptionPeriod" у существующих пользователей.
ALTER TABLE UserSettings ADD COLUMN subscriptionPeriod INTEGER NOT NULL DEFAULT 0;
ALTER TABLE UserSettings ADD COLUMN isDecimalTime INTEGER NOT NULL DEFAULT 0;
