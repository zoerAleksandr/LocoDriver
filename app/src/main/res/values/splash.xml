<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- База (API < 31): системная иконка ПУСТАЯ — на старых устройствах единственный
         брендовый сплэш рисует Compose (BrandedSplash). Фон — тема (values/values-night). -->
    <style name="Theme.LocoDriver.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.LocoDriver</item>
    </style>
</resources>
