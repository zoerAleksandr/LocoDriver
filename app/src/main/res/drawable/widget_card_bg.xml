<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка-обёртка виджета: скруглённый прямоугольник + тонкий бордер.
     Цвета резолвятся по теме (values / values-night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_card_stroke" />
</shape>
