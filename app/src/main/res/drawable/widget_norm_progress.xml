<?xml version="1.0" encoding="utf-8"?>
<!-- Индикатор нормы: трек (bgSubtle) + secondaryProgress (переработка, warning)
     + progress (заполнение до нормы, accent). Устанавливается через
     setProgressBar(max, progress) + setInt("setSecondaryProgress"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="@color/widget_warning" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="@color/widget_accent" />
            </shape>
        </clip>
    </item>
</layer-list>
