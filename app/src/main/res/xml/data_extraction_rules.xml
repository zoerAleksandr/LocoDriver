<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: облачная копия и перенос на новое устройство без профилей участков советника и очереди вклада высот. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="advisor_profiles" />
        <exclude domain="file" path="altitude_contrib" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="advisor_profiles" />
        <exclude domain="file" path="altitude_contrib" />
    </device-transfer>
</data-extraction-rules>
