<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 и ниже (fullBackupContent). Профили участков советника и очередь вклада высот в резервную копию не попадают:
     файлы зашифрованы ключом Keystore, который всё равно не переносится, но и сами они не нужны на другом устройстве. -->
<full-backup-content>
    <exclude domain="file" path="advisor_profiles" />
    <exclude domain="file" path="altitude_contrib" />
</full-backup-content>
