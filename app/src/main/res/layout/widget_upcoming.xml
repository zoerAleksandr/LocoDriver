<?xml version="1.0" encoding="utf-8"?>
<!-- Состояние «Следующий маршрут» (upcoming / upcoming-unknown). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Шапка: лейбл + №маршрута -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/up_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="СЛЕДУЮЩИЙ МАРШРУТ"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.13"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/up_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="№148"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Блок явки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_subtle_block"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ЯВКА"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.13"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/up_time_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Явка" />

            <TextView
                android:id="@+id/up_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:paddingBottom="3dp"
                android:text="16.07.26"
                android:textColor="@color/widget_text_muted"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Путь следования (только upcoming) -->
        <LinearLayout
            android:id="@+id/up_path_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/widget_border_strong" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/up_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Боготол"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginHorizontal="6dp"
                    android:src="@drawable/widget_ic_arrow_right"
                    android:contentDescription="→" />

                <TextView
                    android:id="@+id/up_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Иланская"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
