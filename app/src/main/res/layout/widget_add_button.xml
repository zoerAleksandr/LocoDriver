<?xml version="1.0" encoding="utf-8"?>
<!-- Компактная кнопка «Добавить маршрут» (сбоку от блока отдыха).
     Клик обрабатывает Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="8dp"
    android:paddingVertical="12dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/widget_ic_add"
        android:contentDescription="Добавить маршрут" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Маршрут"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
