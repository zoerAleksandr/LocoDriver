<?xml version="1.0" encoding="utf-8"?>
<!-- Превью развёрнутого виджета в меню установки (RemoteViews-safe, самодостаточное).
     Как и в самом виджете: норма — сверху, «На работе» / направление / кнопки записи — внизу,
     между ними растяжка. Высота карточки зависит от лаунчера (5×2 ячейки), поэтому важное — у краёв. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="18dp">

    <!-- ── Блок нормы ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/widget_preview_metric"
            android:tint="@color/widget_text"
            android:contentDescription="Отработано" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+11:20"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:textColor="@color/widget_warning"
                android:textSize="15sp"
                android:layout_gravity="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="сверх нормы"
                android:textColor="@color/widget_text_muted"
                android:textSize="11.5sp"
                android:layout_marginTop="3dp"
                android:layout_gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="100"
        android:secondaryProgress="100"
        android:progressDrawable="@drawable/widget_norm_progress" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="норма "
            android:textColor="@color/widget_text_muted"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="176:00"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:textColor="@color/widget_text"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- растяжка между верхней и нижней группами -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── Разделитель над нижней группой ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_card_stroke" />

    <!-- ── На работе ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="НА РАБОТЕ"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.13"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5:12"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ── Направление ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Иланская"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="6dp"
            android:src="@drawable/widget_ic_arrow_right"
            android:contentDescription="→" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Боготол"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/widget_card_stroke" />

    <!-- ── Кнопки записи + «АВТО» ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Записанная -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_stamp_done_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_stamp_icon_done">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_arrow_down_on"
                    android:contentDescription="" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Прибытие"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9.5sp"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23:48"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:textColor="@color/widget_text"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/widget_ic_check"
                        android:contentDescription="" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Активная -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_stamp_active_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_stamp_icon_pending">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_arrow_up"
                    android:contentDescription="" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправление"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9.5sp"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Записать"
                    android:textColor="@color/widget_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- «АВТО» -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_auto_btn_off">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="АВТО"
                android:textColor="@color/widget_auto_off_fg"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
