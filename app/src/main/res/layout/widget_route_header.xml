<?xml version="1.0" encoding="utf-8"?>
<!-- Развёрнутый виджет · блок «Текущий маршрут»: номер, направление, поезд. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Заголовок + номер. Скрывается целиком, когда показаны кнопки
         записи (WidgetRender.populateRouteHeader, showCaption=false) —
         освобождает высоту под кнопки. -->
    <LinearLayout
        android:id="@+id/header_caption_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ТЕКУЩИЙ МАРШРУТ"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.13"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/route_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="№147"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Направление -->
    <LinearLayout
        android:id="@+id/route_direction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="9dp">

        <TextView
            android:id="@+id/station_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Иланская"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/route_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="6dp"
            android:src="@drawable/widget_ic_arrow_right"
            android:contentDescription="→" />

        <TextView
            android:id="@+id/station_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Боготол"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Разделитель (FrameLayout — RemoteViews-safe) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/widget_card_stroke" />

    <!-- Подпись поезда / следующей станции -->
    <TextView
        android:id="@+id/train_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="№2654 · КАНСК-ЕНИСЕЙСКИЙ"
        android:fontFamily="@font/jetbrains_mono_semibold"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
