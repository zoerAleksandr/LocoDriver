<?xml version="1.0" encoding="utf-8"?>
<!-- Развёрнутый виджет · верхний блок «Отработано / норма». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Метрика + дельта -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <ImageView
            android:id="@+id/metric_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Отработано" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/delta_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+11:20"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:textColor="@color/widget_warning"
                android:textSize="15sp"
                android:layout_gravity="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/delta_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="сверх нормы"
                android:textColor="@color/widget_text_muted"
                android:textSize="11.5sp"
                android:layout_marginTop="3dp"
                android:layout_gravity="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Индикатор нормы -->
    <ProgressBar
        android:id="@+id/norm_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="100"
        android:secondaryProgress="100"
        android:progressDrawable="@drawable/widget_norm_progress" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="норма "
            android:textColor="@color/widget_text_muted"
            android:textSize="11.5sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/norm_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="176:00"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:textColor="@color/widget_text"
            android:textSize="11.5sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
