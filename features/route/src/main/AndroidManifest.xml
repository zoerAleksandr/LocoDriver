<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- «Моё местоположение» на карте выбора точки станции плеча: разовый запрос по кнопке,
         координаты остаются на устройстве. Фонового доступа нет. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Диалог «Не оптимизировать батарею» для живучести АВТО (SCREEN_SPECS §6.2 п.6а). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <receiver
            android:name="com.z_company.route.autorecord.AutoRecordActionReceiver"
            android:exported="false" />
    </application>

</manifest>
